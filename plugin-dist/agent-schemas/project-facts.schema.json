{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gainglintgaz/vibepromptrig-marketplace/main/plugin-dist/agent-schemas/project-facts.schema.json",
  "title": "VibePromptRig compact project facts",
  "type": "object",
  "required": ["schema_version", "bundle_version", "repository", "scope", "stack", "commands", "environments", "capabilities", "invariants", "context_entrypoint", "evidence"],
  "properties": {
    "schema_version": { "const": 2 },
    "bundle_version": { "type": "string" },
    "repository": { "type": "object", "required": ["name", "identity_basis"], "properties": { "name": { "type": "string" }, "identity_basis": { "enum": ["resolved_root", "resolved_root_and_remote", "resolved_root_and_registry", "fixture"] } } },
    "scope": { "type": "string" },
    "stack": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "commands": { "type": "object" },
    "environments": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "context_entrypoint": { "type": "string" },
    "host_context_observation": { "enum": ["observed", "unknown"] },
    "evidence": { "type": "object", "required": ["audit_commit", "clean_baseline_revision", "report", "runtime_unknowns"], "properties": { "audit_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }, "clean_baseline_revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }, "report": { "type": ["string", "null"] }, "runtime_unknowns": { "type": "array", "items": { "type": "string" } } } }
  }
}
