{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gainglintgaz/vibepromptrig-marketplace/main/plugin-dist/agent-schemas/rule-overrides.schema.json",
  "title": "Rule Overrides -- enable/disable factory rules",
  "description": "enable/disable-only artifact (A2). The resolver NEVER lets a customer disable a required:true rule. v5.0 Sprint 1, arch 9d7294c.",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "enabled"],
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
